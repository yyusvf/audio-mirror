<UserControl x:Class="AudioMirror.Ui.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AudioMirror.Ui.Views"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <!--
            Eine Zelle des Rasters: Überschrift oben, darunter die Karte. Die Karte füllt den
            Rest der Zelle aus - dadurch sind beide Karten einer Reihe gleich hoch, auch wenn
            die eine weniger Inhalt hat als die andere. Ohne das endet jede Karte dort, wo ihr
            Inhalt aufhört, und die Reihe steht unten ausgefranst da.
        -->
        <Style x:Key="SettingsCell" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource ThemedScrollViewer}">
        <!--
            Zwei Spalten, zwei Reihen, vier gleich breite Zellen. Die Fugen kommen vom Rand
            der Zellen, nicht aus den Karten: so ist der Abstand zwischen zwei Karten überall
            gleich breit. Untereinander rutschen die Spalten nicht - dafür sorgt die
            Mindestbreite des Fensters.
        -->
        <Grid Margin="0,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══ Allgemein ═══════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsCell}" Margin="0,0,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource SectionLabel}"
                           Text="{Binding BasicTitle}"
                           Margin="2,0,0,6" />

                <Border Grid.Row="1" Style="{StaticResource SettingsCard}">
                    <StackPanel VerticalAlignment="Top">
                        <CheckBox Style="{StaticResource LabeledCheckBox}"
                                  Content="{Binding AutostartLabel}"
                                  IsEnabled="{Binding AutostartSupported}"
                                  IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="{Binding DoubleClickLabel}"
                                   Margin="0,14,0,5" />
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  ItemsSource="{Binding DoubleClickActions}"
                                  SelectedIndex="{Binding DoubleClickIndex, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="{Binding ThemeLabel}"
                                   Margin="0,12,0,5" />
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="{Binding LanguageLabel}"
                                   Margin="0,12,0,5" />
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  ItemsSource="{Binding Languages}"
                                  SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ Aktualisierungen ════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsCell}" Margin="6,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource SectionLabel}"
                           Text="{Binding UpdateTitle}"
                           Margin="2,0,0,6" />

                <Border Grid.Row="1" Style="{StaticResource SettingsCard}">
                    <StackPanel VerticalAlignment="Top">
                        <RadioButton Style="{StaticResource ThemedRadioButton}"
                                     GroupName="Updates"
                                     Content="{Binding UpdateAutomaticLabel}"
                                     IsChecked="{Binding UpdateAutomatic, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource ThemedRadioButton}"
                                     GroupName="Updates"
                                     Content="{Binding UpdateNotifyLabel}"
                                     IsChecked="{Binding UpdateNotify, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource ThemedRadioButton}"
                                     GroupName="Updates"
                                     Content="{Binding UpdateNeverLabel}"
                                     IsChecked="{Binding UpdateNever, Mode=TwoWay}" />

                        <Button x:Name="CheckNowButton"
                                Style="{StaticResource StandardButton}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Content="{Binding CheckNowLabel}"
                                IsEnabled="{Binding CanCheckNow}"
                                Click="OnCheckNow" />

                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding UpdateStatus}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ Ton ═════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsCell}" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource SectionLabel}"
                           Text="{Binding AudioTitle}"
                           Margin="2,0,0,6" />

                <Border Grid.Row="1" Style="{StaticResource SettingsCard}">
                    <StackPanel VerticalAlignment="Top">
                        <Grid ToolTip="{Binding BufferTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource SecondaryText}"
                                       Text="{Binding BufferLabel}" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource BodyText}"
                                       Text="{Binding BufferDisplay}" />
                        </Grid>
                        <Slider Style="{StaticResource ThemedSlider}"
                                Margin="0,4,0,0"
                                ToolTip="{Binding BufferTip}"
                                Minimum="10" Maximum="250"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding BufferMs, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ Tastenkombination ═══════════════════════════════════════════
                 Steht nicht mehr unter Ton: eine Tastenkombination ist keine
                 Toneinstellung, und als vierter Abschnitt geht das Raster auf. -->
            <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCell}" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource SectionLabel}"
                           Text="{Binding HotkeyTitle}"
                           Margin="2,0,0,6" />

                <Border Grid.Row="1" Style="{StaticResource SettingsCard}">
                    <StackPanel VerticalAlignment="Top">
                        <views:HotkeyBox Hotkey="{Binding Hotkey, Mode=TwoWay}"
                                         HorizontalAlignment="Stretch" />

                        <CheckBox Style="{StaticResource LabeledCheckBox}"
                                  Margin="0,10,0,0"
                                  Content="{Binding HotkeyEnabledLabel}"
                                  IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
