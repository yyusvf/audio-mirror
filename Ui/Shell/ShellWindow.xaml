<Window x:Class="AudioMirror.Ui.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Audio Mirror"
        Width="720" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/AudioMirror.ico"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <!--
        WindowChrome holt die Titelleiste in den Innenbereich, ohne den Fensterrahmen
        aufzugeben: Ziehen, Andocken, Größe ändern und die Fensterliste verhalten sich
        weiterhin wie bei jedem anderen Fenster. Der Weg über WindowStyle="None" mit
        AllowsTransparency würde das alles selbst nachbauen müssen - und nebenbei Mica
        ausschalten, weil das Fenster dann in Software gezeichnet wird.

        GlassFrameThickness bleibt bei 0. Ein ausgedehnter Rahmen bringt auf Windows 11 die
        Fenstertasten des Systems zurück - sie werden genau in dieser Fläche gezeichnet, und
        zwar zusätzlich zu den eigenen. Für Mica wird er nicht gebraucht: den Hintergrund legt
        der Fenstermanager über die ganze Fensterfläche, siehe WindowEffects.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource TitleBarHeight}"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ Titelleiste ═════════════════════════════════════════════════════
             Die Fläche selbst zieht das Fenster. Alles, was angeklickt werden soll,
             braucht IsHitTestVisibleInChrome - sonst verschluckt die Ziehfläche den
             Klick und die Taste reagiert nicht. -->
        <Grid Grid.Row="0" Height="{StaticResource TitleBarHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- DecodePixelWidth waehlt die passende Stufe aus der .ico. Ohne das nimmt WPF
                 die groesste (256) und rechnet sie auf 20 Pixel herunter - das Ergebnis ist
                 weich statt scharf. 40 statt 20, weil die Stufe bei 150 oder 200 Prozent
                 Anzeigeskalierung auf 30 oder 40 Pixel hochgerechnet wird. -->
            <Image Grid.Column="0"
                   Width="20" Height="20"
                   Margin="14,0,0,0"
                   VerticalAlignment="Center">
                <Image.Source>
                    <BitmapImage UriSource="pack://application:,,,/AudioMirror.ico"
                                 DecodePixelWidth="40" />
                </Image.Source>
            </Image>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Audio Mirror"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <!-- IsHitTestVisibleInChrome ist hier entscheidend: ohne das liegt die
                     Ziehflaeche des Fensters darueber und die Reiter lassen sich nicht
                     anklicken. -->
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="DevicesTab"
                                 Style="{StaticResource TitleTab}"
                                 GroupName="Pages"
                                 IsChecked="True"
                                 Checked="OnDevicesTab" />
                    <RadioButton x:Name="SettingsTab"
                                 Style="{StaticResource TitleTab}"
                                 GroupName="Pages"
                                 Checked="OnSettingsTab" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButton}"
                        Content="&#xE921;"
                        Click="OnMinimize" />
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButton}"
                        Content="&#xE922;"
                        Click="OnMaximize" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;"
                        Click="OnClose" />
            </StackPanel>
        </Grid>

        <!-- ══ Arbeitsfläche ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" x:Name="ContentHost" Margin="{StaticResource PagePadding}" />
    </Grid>
</Window>
