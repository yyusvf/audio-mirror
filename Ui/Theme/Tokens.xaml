<!--
    Alle Farben und Maße der Oberfläche. Im übrigen Markup steht keine Farbe und kein
    Pixelwert direkt - was hier nicht als Schlüssel auftaucht, gehört auch nicht ins Markup.

    Die Grautöne entsprechen der Fluent-Palette, wie sie WinUI im Dunkelmodus verwendet:
    weiß mit Alpha, nicht undurchsichtige Grauwerte. Nur so bleibt der Mica-Hintergrund des
    Fensters sichtbar, statt von flachen Flächen zugedeckt zu werden.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ Akzent ══════════════════════════════════════════════════════════════
         Aus dem eigenen Programmsymbol: dessen Verlauf läuft von Blau nach Violett,
         der Vollton dazwischen ist derselbe, den auch das Symbol im Infobereich trägt. -->
    <Color x:Key="AccentColor">#635DF1</Color>
    <Color x:Key="AccentColorLight">#7B76F4</Color>
    <Color x:Key="AccentGradientStart">#3B6FF6</Color>
    <Color x:Key="AccentGradientEnd">#8B4CE8</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorLight}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#38635DF1" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="#1C635DF1" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AccentGradientStart}" />
        <GradientStop Offset="1" Color="{StaticResource AccentGradientEnd}" />
    </LinearGradientBrush>

    <!-- ══ Text ════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5DFFFFFF" />

    <!-- ══ Flächen ═════════════════════════════════════════════════════════════
         Durchweg weiß mit niedrigem Alpha, damit Mica durchscheint. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#08FFFFFF" />

    <!-- Rückfall, wenn Mica nicht zur Verfügung steht (Windows 10). Dann trägt das
         Fenster diesen Ton, und die Flächen darüber wirken wie vorgesehen. -->
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#1F1F23" />

    <!-- ══ Ränder ══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF" />

    <!-- ══ Zustände ════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="OkBrush" Color="#7DDC7D" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F5C451" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F57B7B" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

    <!-- ══ Rundungen ═══════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="RadiusControl">5</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ══ Maße ════════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="TitleBarHeight">48</sys:Double>
    <sys:Double x:Key="DeviceRowHeight">56</sys:Double>
    <sys:Double x:Key="AppRowHeight">40</sys:Double>
    <sys:Double x:Key="CaptionButtonWidth">46</sys:Double>
    <sys:Double x:Key="GlyphButtonSize">32</sys:Double>

    <Thickness x:Key="PagePadding">16,12,16,12</Thickness>
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="RowPadding">12,0,12,0</Thickness>

    <!-- ══ Schrift ═════════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeTitle">14</sys:Double>
    <sys:Double x:Key="FontSizeHeading">17</sys:Double>

</ResourceDictionary>
